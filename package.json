{
  "version": "0.1",
  "name": "mail-processing-automation",
  "type": "module",
  "dependencies": {
    "@types/mailparser": "^3.4.5",
    "mailparser": "^3.7.2",
    "typescript": "^4.9.4",
    "yargs": "^17.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.20.2",
    "@faker-js/faker": "^8.2.0",
    "@types/jest": "^29.2.5",
    "@types/node": "^18.11.17",
    "@types/yargs": "^17.0.17",
    "babel-jest": "^29.3.1",
    "husky": "^9.1.6",
    "jest": "^29.3.1",
    "lint-staged": "^15.2.2",
    "ts-jest": "^29.0.3",
    "tsx": "^4.7.1"
  },
  "scripts": {
    "build": "tsc --build",
    "build-test": "tsc --build && tsc --project tsconfig.test.json",
    "jest-with-tla-support": "ts-node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test": "npm run build-test && npm run jest-with-tla-support",
    "run": "npx tsx src/index.ts",
    "prepare": "husky"
  },
  "main": "./dist/index",
  "typings": "./types",
  "prettier": {
    "tabWidth": 2,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "bracketSpacing": true,
    "printWidth": 80
  }
}
