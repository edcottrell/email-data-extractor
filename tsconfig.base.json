{
  "compilerOptions": {
    "esModuleInterop": true,
    "lib": ["ES2022"],
    "module": "ES2022",
    "target": "ESNext",
    "preserveConstEnums": true,
    "moduleResolution": "NodeNext",
    "strict": true,
    "sourceMap": true,
    "types": ["node", "jest"],
    "skipLibCheck": true,
    "baseUrl": "./",
    "paths" : {
      "*": ["*"],
      "@app/*": ["src/*.ts"],
      "@test/*": ["test/*.ts"],
      "@test-utils/*": ["test/test-utils/*.ts"]
    },
    "allowJs": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "types"]
}