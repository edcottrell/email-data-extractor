{
  "compilerOptions": {
    "esModuleInterop": true,
    "lib": ["ES2022"],
    "module": "NodeNext",
    "target": "ESNext",
    "preserveConstEnums": true,
    "moduleResolution": "NodeNext",
    "strict": true,
    "sourceMap": true,
    "types": ["node", "jest"],
    "skipLibCheck": true,
    "allowJs": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "types"]
}